      <!-- Preserve the old HIL IMU mounting convention; verify feedback signs on hardware. -->
      <sensor name="imu_sensor" type="imu">
        <pose>0.00000474355 0.000103915 0.00455 0 0 -1.5707963267948966</pose>
        <always_on>true</always_on>
        <update_rate>1000</update_rate>
        <topic>/mini_shell/imu</topic>
      </sensor>
      <!-- A single downward ray measures range, not optical flow. -->
      <sensor name="rangefinder" type="gpu_lidar">
        <pose>0 0.055 -0.0045 0 1.5707963267948966 0</pose>
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <topic>/mini_shell/range</topic>
        <lidar>
          <scan>
            <horizontal>
              <samples>1</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>0</max_angle>
            </horizontal>
          </scan>
          <range><min>0.01</min><max>2.0</max><resolution>0.01</resolution></range>
        </lidar>
      </sensor>
