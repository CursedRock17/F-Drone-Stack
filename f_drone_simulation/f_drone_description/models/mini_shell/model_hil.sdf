      <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
      <motorSpeedPubTopic>motor_speed/1</motorSpeedPubTopic>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>mini_shell</robotNamespace>
      <jointName>motor_prop_3</jointName>
      <linkName>prop_3</linkName>
      <turningDirection>cw</turningDirection>
      <maxRotVelocity>5760</maxRotVelocity>
      <motorConstant>6.0e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>2</actuator_number>
      <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
      <motorSpeedPubTopic>motor_speed/2</motorSpeedPubTopic>
      <motorType>velocity</motorType>
    </plugin>
    <plugin
      filename="gz-sim-multicopter-motor-model-system"
      name="gz::sim::systems::MulticopterMotorModel">
      <robotNamespace>mini_shell</robotNamespace>
      <jointName>motor_prop_4</jointName>
      <linkName>prop_4</linkName>
      <turningDirection>ccw</turningDirection>
      <maxRotVelocity>5760</maxRotVelocity>
      <motorConstant>6.0e-08</motorConstant>
      <momentConstant>0.005964552</momentConstant>
      <rotorDragCoefficient>8.06428e-05</rotorDragCoefficient>
      <rollingMomentCoefficient>0.0000001</rollingMomentCoefficient>
      <rotorVelocitySlowdownSim>20</rotorVelocitySlowdownSim>
      <actuator_number>3</actuator_number>
      <commandSubTopic>gazebo/command/motor_speed</commandSubTopic>
      <motorSpeedPubTopic>motor_speed/3</motorSpeedPubTopic>
      <motorType>velocity</motorType>
    </plugin>
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/mini_shell/odometry</odom_topic>
      <tf_topic>/mini_shell/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
    </plugin>
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/mini_shell/joint_states</topic>
      <update_rate>50</update_rate>
    </plugin>
    <!-- Teensy owns the controller; no Gazebo velocity controller in this variant. -->
    <plugin filename="DroneSerial" name="f_drone_gazebo::DroneSerial">
      <port>/dev/ttyACM0</port>
      <imu_link>base_link</imu_link>
      <rangefinder_link>base_link</rangefinder_link>
      <imu_topic>/mini_shell/imu</imu_topic>
      <rangefinder_topic>/mini_shell/range</rangefinder_topic>
      <actuator_topic>/mini_shell/gazebo/command/motor_speed</actuator_topic>
    </plugin>
  </model>
</sdf>
