      <!-- IMU in the middle of drone-->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>1000</update_rate>
        <visualize>true</visualize>
        <topic>imu</topic>
        <imu>
          <orientation_reference_frame>
            <localization>NWU</localization>
            <custom_rpy>0 0 0</custom_rpy>
            <grav_dir_x>1 0 0</grav_dir_x>
          </orientation_reference_frame>
          <enable_orientation>true</enable_orientation>
        </imu>
      </sensor>
      <!-- Rangefinder at end of drone-->
      <sensor name='optical_flow' type='gpu_lidar'>"
          <pose relative_to='base_link'>0 0.055 -0.0045 0 1.5708 -1.5708</pose>
          <topic>radar</topic>
          <enable_metrics>false</enable_metrics>
          <update_rate>100</update_rate>
          <ray>
              <scan>
                  <horizontal>
                      <samples>10</samples>
                      <resolution>1</resolution>
                      <min_angle>-0.2186</min_angle>
                      <max_angle>0.2186</max_angle>
                  </horizontal>
                  <vertical>
                      <samples>1</samples>
                      <resolution>0.01</resolution>
                      <min_angle>0</min_angle>
                      <max_angle>0</max_angle>
                  </vertical>
              </scan>
              <range>
                <min>0.01</min>
                <max>2.0</max>
                <resolution>0.01</resolution>
              </range>
          </ray>
          <always_on>1</always_on>
          <visualize>true</visualize>
      </sensor>
    </link>
    <joint name='motor_prop_1' type='revolute'>
      <parent>base_link</parent>
