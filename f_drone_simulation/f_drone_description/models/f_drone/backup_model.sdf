      <!-- Rangefinder at end of drone-->
      <sensor name='optical_flow' type='gpu_lidar'>"
          <pose relative_to='base_link'>0 0.055 -0.0045 0 1.5708 -1.5708</pose>
          <topic>radar</topic>
