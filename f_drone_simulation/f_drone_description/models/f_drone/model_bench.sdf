<?xml version="1.0" ?>
<sdf version='1.11'>
  <model name='drone'>
    <link name='drone/base_link'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <!-- UNIFORM MASS MODEL.
             Total drone weighed at 203.4 g. CAD accounts for 47.40 g of
             structure + 3.03 g of props; the battery (102.58 g measured) and
             ~50.4 g of wiring/screws/standoffs/RX are not modelled per-part.
             Rather than assign materials, the materials-less CAD tensor is
             scaled by 4.2270 so the total hits the measured 203.4 g, i.e.
             density is assumed uniform over the modelled geometry.
             CoM is the CAD geometric centroid; it does NOT account for the
             battery sitting ~19 mm low, so expect some CoM error in z. -->
        <pose>-7.20278e-05 -0.00817605 0.000433282 0 0 0</pose>
        <mass>0.200365</mass>
        <inertia>
          <ixx>0.000321462</ixx>
          <ixy>4.4414e-07</ixy>
          <ixz>-3.54974e-07</ixz>
          <iyy>0.000221201</iyy>
          <iyz>5.86328e-06</iyz>
          <izz>0.000489124</izz>
        </inertia>
      </inertial>
      <collision name="base_link_collision">
        <geometry>
          <box>
            <size>0.1029 0.09925 0.10</size>
          </box>
        </geometry>
      </collision>
      <visual name='base_link_visual'>
        <pose>0.040281999999999998 -0.0559978 -0.047511600000000001 1.5708 0 -2.3561899999999998</pose>
        <geometry>
          <mesh>
            <scale>1 1 1</scale>
            <uri>model://f_drone/assets/leg.stl</uri>
          </mesh>
        </geometry>
        <material>
          <diffuse>0.465686262 0.818627477 0.299019992 1</diffuse>
          <ambient>0.465686262 0.818627477 0.299019992 1</ambient>
        </material>
      </visual>
