      <!-- Rangefinder at end of drone-->
      <sensor name='optical_flow' type='gpu_lidar'>"
          <pose relative_to='drone/base_link'>0 0.055 -0.0045 0 1.5708 -1.5708</pose>
          <topic>radar</topic>
          <enable_metrics>false</enable_metrics>
          <update_rate>100</update_rate>
          <ray>
              <scan>
                  <horizontal>
                      <samples>10</samples>
                      <resolution>1</resolution>
                      <min_angle>-0.2186</min_angle>
                      <max_angle>0.2186</max_angle>
                  </horizontal>
                  <vertical>
                      <samples>1</samples>
                      <resolution>0.01</resolution>
                      <min_angle>0</min_angle>
                      <max_angle>0</max_angle>
                  </vertical>
              </scan>
              <range>
                <min>0.01</min>
                <max>2.0</max>
                <resolution>0.01</resolution>
              </range>
          </ray>
          <always_on>1</always_on>
          <visualize>true</visualize>
      </sensor>
    </link>
    <link name='drone/prop_1'>
      <pose>-0.05145 0.049625 0.01053039 0 0 0</pose>
