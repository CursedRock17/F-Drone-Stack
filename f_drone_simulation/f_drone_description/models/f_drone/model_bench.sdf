          <ambient>0.107843123 0.397058755 0.862744987 1</ambient>
        </material>
      </visual>
      <!-- IMU in the middle of drone.
           Pose is the physical mounting rotation of the MPU6050 relative to the
           CAD body frame (CAD has +Y forward; dRehmFlight/Madgwick expects the
           gyro X axis along body -Y). Yaw -90 deg. If pitch response is stable
           but roll diverges (or vice versa), the real mount also includes a
           180 deg roll -- change to "0 0 0 3.14159 0 -1.5708". -->
      <sensor name="imu_sensor" type="imu">
        <pose>0 0 0 0 0 -1.5708</pose>
        <always_on>1</always_on>
        <visualize>true</visualize>
        <topic>imu</topic>
        <imu>
          <orientation_reference_frame>
            <localization>NWU</localization>
            <custom_rpy>0 0 0</custom_rpy>
            <grav_dir_x>1 0 0</grav_dir_x>
          </orientation_reference_frame>
          <enable_orientation>true</enable_orientation>
        </imu>
      </sensor>
