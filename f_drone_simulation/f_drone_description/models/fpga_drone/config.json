// Need this file to export to urdf through 'onshape-to-robot'
// *Note* Don't forget your .env with keys to the workspace when exporting
{
    // Onshape URL of the assembly
    "url": "https://cad.onshape.com/documents/8c10e389dda3d1b6cbe23871/w/5a5746d77355e6e80cdff190/e/a8c47972b1a515a86b80b7ad",
    // Output format
    "output_format": "urdf",
    "output_filename": "model",
    "assembly_name": "drone",

    // Beneficial ROS Info
    "package_name": "f_drone_description/models/fpga_drone",
    "robot_name": "drone",
    "set_zero_mass_to_fixed": true,

    // Provide Information to Joints *not neccessary*
    "joint_properties": {
      "motor_prop_*": {
        "max_effort": 100.0,
        "max_velocity": 20000.0,
        "type": "revolute",
        "limits": [-1e+16, 1e+16],
      }
    },
}
